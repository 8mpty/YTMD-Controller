{
  "expo": {
    "name": "YTMD-Controller",
    "slug": "ytmd-controller",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/new-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/new-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "bundleIdentifier": "com.x8mpty.ytmdcontroller"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.x8mpty.ytmdcontroller",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/new-icon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false,
          "android": {
            "usesCleartextTraffic": true,
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "enableFTS": false,
            "useSQLCipher": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2f2d6798-37c7-42aa-8bb5-7fb5d2d21373"
      }
    },
    "owner": "8mpty"
  }
}
